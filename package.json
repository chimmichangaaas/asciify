{
  "name": "asciify",
  "version": "1.0.0",
  "private": true,
  "description": "Asciify — turn images, GIFs and videos into typographic art. Standalone web dashboard plus a Figma plugin.",
  "author": "Yash Saindane",
  "license": "UNLICENSED",
  "homepage": "https://github.com/chimmichangaaas/asciify",
  "repository": {
    "type": "git",
    "url": "https://github.com/chimmichangaaas/asciify.git"
  },
  "scripts": {
    "dev":       "node build.mjs --watch",
    "build":     "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "typecheck": "tsc --noEmit",
    "preview":   "echo 'Open dist/dashboard.html in your browser'"
  },
  "keywords": ["ascii", "ascii-art", "figma-plugin", "halftone", "dithering", "creative-coding"],
  "devDependencies": {
    "@figma/plugin-typings": "^1.128.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2"
  }
}
